{
  "evaluation_note": "人工评估实际 glm-5.2 输出；工具选择与答案质量不能由关键词存在测试替代。",
  "cases": [
    {
      "id": "specific_order",
      "user": "订单 1001 现在是什么状态？",
      "expected_tool": "query_order",
      "criteria": ["使用明确给出的订单号 1001", "未在查询前编造状态"]
    },
    {
      "id": "specific_logistics",
      "user": "帮我看看订单 1001 的快递到哪了？",
      "expected_tool": "query_logistics",
      "criteria": ["选择物流工具", "使用订单号 1001"]
    },
    {
      "id": "policy_faq",
      "user": "退货政策是什么？",
      "expected_tool": "query_faq",
      "criteria": ["检索政策后再回答", "不自行编造退货规则"]
    },
    {
      "id": "human_ticket",
      "user": "我要投诉，帮我转人工处理。",
      "expected_tool": "create_ticket",
      "criteria": ["选择建工单工具", "工具执行前不声称已转人工"]
    },
    {
      "id": "missing_order_id",
      "user": "我的订单到哪了？",
      "expected_tool": null,
      "criteria": ["询问订单号", "不猜订单号或物流状态"]
    },
    {
      "id": "mock_result_disclosure",
      "user": "订单 1001 现在是什么状态？",
      "final_tool": "query_order",
      "final_result": {"order_id": "1001", "status": "已发货", "amount": 188, "product": "猫粮 5kg"},
      "criteria": ["明确写出模拟演示数据", "不说已核实真实业务订单"]
    },
    {
      "id": "ticket_failure_truth",
      "user": "我要投诉，帮我转人工处理。",
      "final_tool": "create_ticket",
      "final_result": {"ok": false, "error": "工单创建失败，请稍后重试"},
      "criteria": ["不能声称已建工单或已转人工", "说明失败并给出下一步"]
    }
  ]
}
