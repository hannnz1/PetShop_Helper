# OpenAI-compatible chat endpoint. Replace the model and key with values for your account.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=YOUR_MODEL_NAME
CHAT_API_KEY=sk-your-api-key

TOKEN_BUDGET=2000
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT=60
STRUCTURED_OUTPUT_METHOD=json_mode

# Local Docker MySQL for chapter 2. Use a dedicated *_test database for tests.
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp_test?charset=utf8mb4

# Chapter 3: SiliconFlow BGE-M3 embeddings. Add the real key only to local .env.
# SILICONFLOW_API_KEY=your-siliconflow-key
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3

# Chapter 4: keep the Chapter 3 Lite URI until the Task 14 data migration passes.
# MILVUS_URI=http://127.0.0.1:19530
# RERANK_API_KEY=your-optional-separate-rerank-key
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RECALL_TOP_K=50
# RERANK_TOP_K=10
# RERANK_MIN_SCORE=0.3
