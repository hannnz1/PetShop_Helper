# OpenAI-compatible chat endpoint. Replace the model and key with values for your account.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=YOUR_MODEL_NAME
CHAT_API_KEY=sk-your-api-key
CHAT_STREAM_USAGE=false
# Set true only when the OpenAI-compatible upstream supports streamed usage metadata.

# Legacy fixed cap, only for old deployments. If set, it remains a hard cap
# and participates in the Chapter 7 one-turn self-check.
# TOKEN_BUDGET=2000
# Chapter 7 window allocator:
MODEL_CONTEXT_WINDOW=32768
MAX_OUTPUT_TOKENS=2000
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
# TOOL_RESULT_MAX_TOKENS reserves the aggregate result payload for each ReAct step.
EXPECTED_HISTORY_TURNS=20
STEADY_TURN_CHARS=280
CJK_CHARS_PER_TOKEN=1.0
SUMMARY_INJECTION_MAX_TOKENS=250
CHAT_MAX_TOKENS=1024
# CHAT_MAX_TOKENS caps each agent_llm response, including tool-call arguments.
# The budget reserves MAX_OUTPUT_TOKENS for the separate final_answer call.
CHAT_TIMEOUT=60
STRUCTURED_OUTPUT_METHOD=json_mode
MAX_AGENT_STEPS=6
GRAPH_CHECKPOINT_PATH=data/ch05/checkpoints.sqlite

# Local Docker MySQL for chapter 2. Use a dedicated *_test database for tests.
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/mewhelp_test?charset=utf8mb4

# Chapter 3: SiliconFlow BGE-M3 embeddings. Add the real key only to local .env.
# SILICONFLOW_API_KEY=your-siliconflow-key
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3

# Chapter 4: keep the Chapter 3 Lite URI until the Task 14 data migration passes.
# MILVUS_URI=http://127.0.0.1:19530
# RERANK_API_KEY=your-optional-separate-rerank-key
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RECALL_TOP_K=50
# RERANK_TOP_K=10
# RERANK_MIN_SCORE=0.3
# Missing or stale calibration keeps the existing top-1 gate.
EVIDENCE_CALIBRATION_PATH=data/ch09/reports/confidence_calibration.json

# Chapter 8: local mock MCP services and write-timeout demonstration.
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
TOOL_DEFAULT_TIMEOUT=5
MCP_TOOL_TIMEOUT=10
TOOL_MAX_RETRIES=2
DEMO_TICKET_DELAY_SECONDS=0

# Chapter 9: optional local Langfuse tracing. Set keys from the local project UI.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=lf_pk_your-local-project-key
# LANGFUSE_SECRET_KEY=lf_sk_your-local-project-key
# OBSERVABILITY_ADMIN_TOKEN=generate-a-long-random-token-for-read-only-report-api

# Local lightweight classifier (no remote text endpoint)
CLASSIFIER_BASE_URL=http://127.0.0.1:8110
CLASSIFIER_TIMEOUT=30
