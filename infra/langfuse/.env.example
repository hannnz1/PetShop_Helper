POSTGRES_DB=langfuse
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_RANDOM
SALT=CHANGE_ME_SALT_RANDOM
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
