CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_RANDOM
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_RANDOM
REDIS_AUTH=CHANGE_ME_REDIS_RANDOM
